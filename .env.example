# ethan_workbench .env: copy to .env (gitignored, bundled as a Flutter asset).
# Every app's .env.example has this shape: the shared sync keys, then the
# keys only this app reads.
#
# Home-server hosts come from ethan_sync/home_server.env. Set SERVER_HOST_LAN /
# SERVER_HOST_TAILSCALE here only to point this app at its own backend.

# Signs this app's PowerSync JWTs. The server's ETHAN_WORKBENCH_POWERSYNC_JWT_KEY is
# its base64 form; infra/provision-sync-app.sh writes both.
POWERSYNC_JWT_SECRET=

# Mac Bonjour / local hostname (without scheme), e.g. MacBook-Pro.local
SERVER_HOST=your-mac.local
SERVER_PORT=8787

# Shared password for the iOS client (Authorization: Bearer …). Required.
SERVER_PASSWORD=

# Absolute path to the directory that contains your Flutter app projects
FLUTTER_ROOT=/path/to/Flutter

# Optional. Defaults to $FLUTTER_ROOT/ethan_workbench/deploy.rb
# (the copy shipped in this repo).
# DEPLOY_RB=/custom/path/to/deploy.rb
