# Copy to .env and fill in your machine values. The app loads `.env` at startup.
# Only `.env` is bundled as a Flutter asset (gitignored).

# Mac Bonjour / local hostname (without scheme), e.g. MacBook-Pro.local
PHONE_DEPLOY_AGENT_HOST=your-mac.local
PHONE_DEPLOY_AGENT_PORT=8787

# Absolute path to the directory that contains your Flutter app projects
PHONE_DEPLOY_FLUTTER_ROOT=/path/to/Flutter

# Optional. Defaults to $PHONE_DEPLOY_FLUTTER_ROOT/phone_deploy/deploy.rb
# (the copy shipped in this repo).
# PHONE_DEPLOY_DEPLOY_RB=/custom/path/to/deploy.rb

# ethan_sync (shared deploy ledger on the home server)
POWERSYNC_JWT_SECRET=
SERVER_HOST_LAN=<lan-host-or-ip>
SERVER_HOST_TAILSCALE=
